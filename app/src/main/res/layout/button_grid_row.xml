<?xml version="1.0" encoding="utf-8"?>
<!-- 按钮行布局模板 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:layout_marginTop="2dp"
    android:layout_marginBottom="2dp">

    <!-- 按钮1 -->
    <FrameLayout
        android:id="@+id/btn_frame_1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginEnd="2dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_1"
            style="@style/FunctionButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="40dp"
            android:text="按钮"
            app:cornerRadius="8dp" />

        <TextView
            android:id="@+id/badge_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|top"
            android:layout_marginTop="1dp"
            android:layout_marginEnd="2dp"
            android:text=""
            android:textSize="9sp"
            android:textColor="#FF6200"
            android:background="@drawable/bg_badge"
            android:visibility="gone" />
    </FrameLayout>

    <!-- 按钮2 -->
    <FrameLayout
        android:id="@+id/btn_frame_2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginEnd="2dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_2"
            style="@style/FunctionButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="40dp"
            android:text="按钮"
            app:cornerRadius="8dp" />

        <TextView
            android:id="@+id/badge_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|top"
            android:layout_marginTop="1dp"
            android:layout_marginEnd="2dp"
            android:text=""
            android:textSize="9sp"
            android:textColor="#FF6200"
            android:background="@drawable/bg_badge"
            android:visibility="gone" />
    </FrameLayout>

    <!-- 按钮3 -->
    <FrameLayout
        android:id="@+id/btn_frame_3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginEnd="2dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_3"
            style="@style/FunctionButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="40dp"
            android:text="按钮"
            app:cornerRadius="8dp" />

        <TextView
            android:id="@+id/badge_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|top"
            android:layout_marginTop="1dp"
            android:layout_marginEnd="2dp"
            android:text=""
            android:textSize="9sp"
            android:textColor="#FF6200"
            android:background="@drawable/bg_badge"
            android:visibility="gone" />
    </FrameLayout>

    <!-- 按钮4 -->
    <FrameLayout
        android:id="@+id/btn_frame_4"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_4"
            style="@style/FunctionButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="40dp"
            android:text="按钮"
            app:cornerRadius="8dp" />

        <TextView
            android:id="@+id/badge_4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|top"
            android:layout_marginTop="1dp"
            android:layout_marginEnd="2dp"
            android:text=""
            android:textSize="9sp"
            android:textColor="#FF6200"
            android:background="@drawable/bg_badge"
            android:visibility="gone" />
    </FrameLayout>

</LinearLayout>

