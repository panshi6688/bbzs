<resources>
    <!-- 应用主题 -->
    <style name="Theme.Bbzs" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">#FF6200</item>
        <item name="colorPrimaryVariant">#E55800</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">#03DAC5</item>
        <item name="colorOnSecondary">#000000</item>
    </style>

    <!-- 功能按钮样式 -->
    <style name="FunctionButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">#333333</item>
        <item name="cornerRadius">8dp</item>
        <item name="strokeColor">#DDDDDD</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:paddingLeft">4dp</item>
        <item name="android:paddingRight">4dp</item>
    </style>

    <!-- 标签文本样式 -->
    <style name="TabTextStyle" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">11sp</item>
        <item name="android:maxLines">2</item>
        <item name="android:gravity">center</item>
        <item name="android:lineSpacingMultiplier">0.8</item>
    </style>
</resources>

